# 1. Thư viện (Rất nặng, không cần lưu vì có thể cài lại bằng npm install)
node_modules/

# 2. Các file bảo mật (QUAN TRỌNG: Chứa mật khẩu DB, tuyệt đối không đưa lên Git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 3. File Log lỗi (Không cần thiết)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# 4. File rác của hệ điều hành
.DS_Store
Thumbs.db

# 5. Cấu hình IDE (Tùy chọn, thường là của cá nhân dev)
.vscode/
.idea/